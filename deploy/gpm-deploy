#!/usr/bin/env python3
"""Install a tagged release of GPM, somewhere nobody edits (D79).

A pool that spends money must run code that cannot change under it. Live, three times in one
week, a fix was on disk and the running supervisor was not running it — and each time the only
thing that noticed was a rented host failing. The cause under all three was that the live pool
ran from the development tree as an editable install, so the code being edited *was* the code
deployed.

This builds a release instead:

    deploy/gpm-deploy v0.6.1                # from this repository's tag
    deploy/gpm-deploy v0.6.1 --activate     # and point `current` at it

Each release is a directory holding its own virtual environment, installed **non-editable**
from `git archive` of the tag — so it contains the tag's code and nothing from the working
tree, committed or not. `current` is a symlink; activating is one atomic swap, and rolling back
is activating the previous tag, which is still sitting there.

Deliberately standalone: stdlib only, and it never imports gpm_server. A deploy tool that
needed the thing it deploys could not fix a broken release.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path
from typing import Optional

DEFAULT_ROOT = Path(os.environ.get("GPM_RELEASES", "~/.local/share/gpm/releases")).expanduser()
PACKAGES = ("server", "agent", "client")


def run(command: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(command, check=True, text=True, capture_output=True, **kwargs)


def resolve_tag(repo: Path, tag: str) -> str:
    """The commit this tag names. Refuses anything that is not a tag: a branch moves, and a
    release that moves is the problem this exists to remove."""
    try:
        run(["git", "-C", str(repo), "rev-parse", "--verify", f"refs/tags/{tag}"])
    except subprocess.CalledProcessError:
        existing = subprocess.run(
            ["git", "-C", str(repo), "tag", "--list"], text=True, capture_output=True
        ).stdout.split()
        raise SystemExit(
            f"{tag!r} is not a tag in {repo}."
            + (f" Tags here: {', '.join(existing[-8:])}" if existing else " This repository has no tags yet.")
        ) from None
    return run(["git", "-C", str(repo), "rev-list", "-n", "1", f"refs/tags/{tag}"]).stdout.strip()


def extract(repo: Path, tag: str, into: Path) -> None:
    """The tag's tree, and only the tag's tree — never the working directory."""
    with tempfile.TemporaryDirectory() as scratch:
        archive = Path(scratch) / "release.tar"
        with archive.open("wb") as handle:
            subprocess.run(
                ["git", "-C", str(repo), "archive", "--format=tar", tag],
                check=True, stdout=handle,
            )
        with tarfile.open(archive) as tar:
            # `filter="data"` refuses absolute paths, `..` and device files in the archive.
            # It arrived in 3.12; on an older interpreter the same rule is applied by hand,
            # because this script may be run by whatever python3 the machine happens to have.
            if sys.version_info >= (3, 12):
                tar.extractall(into, filter="data")
            else:
                for member in tar.getmembers():
                    name = Path(member.name)
                    if name.is_absolute() or ".." in name.parts:
                        raise SystemExit(f"the archive holds an unsafe path: {member.name}")
                    if not (member.isfile() or member.isdir()):
                        raise SystemExit(f"the archive holds a {member.type!r} entry: {member.name}")
                tar.extractall(into)


def build(release: Path, python: Optional[str]) -> Path:
    """A virtual environment holding a non-editable install of every package.

    The interpreter is the one the *release* requires, not the one that happens to be running
    this script: a deploy tool invoked by the system python3 must still build a release that
    needs a newer one.
    """
    venv = release / "venv"
    wanted = python or requires_python(release)
    uv = shutil.which("uv")
    if uv:
        run([uv, "venv", "--python", wanted, str(venv)])
        pip_install = [uv, "pip", "install", "--python", str(venv / "bin" / "python")]
    else:
        interpreter = python or find_interpreter(requires_python(release))
        run([interpreter, "-m", "venv", str(venv)])
        pip_install = [str(venv / "bin" / "python"), "-m", "pip", "install"]
    # Not `-e`: the release must not reference the tree it was built from.
    run([*pip_install, *[str(release / name) for name in PACKAGES]])
    return venv


def smoke_check(venv: Path, tag: str, version: str) -> None:
    """Prove the thing that was installed is the thing that will run, before anything points at
    it. A release that cannot say what it is does not become `current`."""
    gpm = venv / "bin" / "gpm"
    if not gpm.exists():
        raise SystemExit(f"{gpm} was not installed; the release is not usable")
    said = run([str(gpm), "--version"]).stdout.strip()
    if f"release {tag}" not in said:
        raise SystemExit(f"the built release does not identify itself as {tag}: {said!r}")
    if version not in said:
        raise SystemExit(f"the built release reports a version that is not {version}: {said!r}")
    # The agent it would put on a rented host comes from this same install, so it is packed
    # here too: a release that cannot pack its agent would ship hosts without one.
    packed = run([
        str(venv / "bin" / "python"), "-c",
        "import tempfile, pathlib; from gpm_server import agentpkg;"
        "print(agentpkg.build(pathlib.Path(tempfile.mkdtemp()) / 'a.pyz').stat().st_size)",
    ]).stdout.strip()
    if int(packed) < 100_000:
        raise SystemExit(f"the release packed an implausible agent ({packed} bytes)")


def requires_python(release: Path) -> str:
    """The floor the release declares, as uv understands it (e.g. ">=3.11")."""
    for line in (release / "server" / "pyproject.toml").read_text().splitlines():
        if line.replace(" ", "").startswith("requires-python="):
            return line.split('"')[1]
    return ">=3.11"


def find_interpreter(constraint: str) -> str:
    """Without uv, look for a python that meets the floor rather than assume this one does."""
    floor = tuple(int(n) for n in constraint.lstrip(">=~^ ").split(".")[:2])
    if sys.version_info[:2] >= floor:
        return sys.executable
    for minor in range(20, floor[1] - 1, -1):
        found = shutil.which(f"python3.{minor}")
        if found:
            return found
    raise SystemExit(
        f"this release needs python{constraint} and none was found; install uv, or pass "
        f"--python /path/to/python3"
    )


def declared_version(release: Path) -> str:
    text = (release / "server" / "pyproject.toml").read_text()
    for line in text.splitlines():
        if line.startswith("version = "):
            return line.split('"')[1]
    raise SystemExit("the release has no version in server/pyproject.toml")


def activate(root: Path, release: Path) -> Path:
    """One atomic swap. Whatever `current` pointed at is still there to go back to."""
    current = root / "current"
    pointer = root / f".current.{os.getpid()}"
    pointer.symlink_to(release, target_is_directory=True)
    pointer.replace(current)  # atomic on the same filesystem
    return current


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gpm-deploy", description=__doc__.splitlines()[0])
    parser.add_argument("tag", help="the git tag to deploy, e.g. v0.6.1")
    parser.add_argument("--repo", default=str(Path(__file__).resolve().parent.parent))
    parser.add_argument("--root", default=str(DEFAULT_ROOT), help="where releases are kept")
    parser.add_argument("--python", default=None, help="override the interpreter to build with")
    parser.add_argument("--activate", action="store_true", help="point `current` at it once built")
    parser.add_argument("--force", action="store_true", help="rebuild a tag already deployed")
    args = parser.parse_args(argv)

    repo, root = Path(args.repo).resolve(), Path(args.root).expanduser()
    commit = resolve_tag(repo, args.tag)
    release = root / args.tag

    if release.exists():
        if not args.force:
            print(f"{args.tag} is already deployed at {release}; --force rebuilds it")
            if args.activate:
                print(f"current -> {activate(root, release)}")
            return 0
        shutil.rmtree(release)

    print(f"building {args.tag} ({commit[:12]}) in {release}")
    release.mkdir(parents=True)
    try:
        extract(repo, args.tag, release)
        version = declared_version(release)
        venv = build(release, args.python)
        (release / "RELEASE.json").write_text(json.dumps({
            "tag": args.tag, "commit": commit, "version": version,
            "built_at": time.time(), "built_from": str(repo),
        }, indent=2) + "\n")
        smoke_check(venv, args.tag, version)
    except (subprocess.CalledProcessError, SystemExit) as exc:
        # A half-built release must never be left where something could activate it.
        shutil.rmtree(release, ignore_errors=True)
        detail = getattr(exc, "stderr", None) or str(exc)
        raise SystemExit(f"deploying {args.tag} failed, and nothing was changed:\n{detail}") from None

    print(f"built: {release}/venv/bin/gpm")
    if args.activate:
        print(f"current -> {activate(root, release)}")
        print("now restart the supervisor and router so they run it")
    else:
        print(f"to use it:  {sys.argv[0]} {args.tag} --activate")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
