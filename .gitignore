.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# Local pool state and configuration (root only — server/examples/pool.yaml is the tracked
# sample the quickstart tells people to copy, and must stay committed)
/pool.yaml
# applied-configuration history kept beside the file: a copy of the local configuration
*.yaml.versions/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# The host agent, packed for pushing to rented hosts — built, never committed.
gpm-agent.pyz

# Environment files that hold credentials — the provider key and the admin key live in the
# owner's shell, never in the repository. `env` at the root was found holding both.
env
.env
.env.*
