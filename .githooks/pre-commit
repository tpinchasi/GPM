#!/bin/sh
# Refuses a commit that carries a credential (CLAUDE.md, "No secret reaches the repository").
# The repository is public: a key committed is a key published, even if a later commit removes it.
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed, so this commit cannot be checked for secrets." >&2
    echo "Install it (https://github.com/gitleaks/gitleaks, e.g. 'brew install gitleaks') and commit again." >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
